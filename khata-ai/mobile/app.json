{
  "expo": {
    "name": "Digi Hisab",
    "slug": "digi-hisab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.digihisab.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0B2239"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Digi Hisab to use biometric verification (Fingerprint / Face ID) for direct 1-tap login."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
